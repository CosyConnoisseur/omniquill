<div class="parchment-container mt-3 mb-5 mx-auto headings">
  <h2>Log in</h2>

  <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="form-inputs">
      <%= f.input :email,
                  required: false,
                  autofocus: true,
                  input_html: { autocomplete: "email" } %>
      <%= f.input :password,
                  required: false,
                  input_html: { autocomplete: "current-password" } %>
      <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
    </div>

    <div class="form-actions">
      <%= f.button :submit, "Log in", class: "btn btn-dark" %>
    </div>
  <% end %>
  <p class="mt-5 mb-0">New user?</p>
  <%= render "devise/shared/links", class: "" %>
  <div class="text-center">
  No time?
  <br>
  <br>
  <%= button_to create_guest_session_path, method: :post, class: "guest-button rounded-3" do %>
    <span style="font-family: 'Jersey 15';font-size: 2.5rem;">Explore as</span>
    <span class="magic-text position-relative ms-3", style="font-family: 'Jersey 15';font-size: 2.5rem; -webkit-text-stroke: 1px black;">
      <%= image_tag "sparkle.webp", class: "position-absolute top-40", style: "max-height: 50px; max-width: 100%; top:15px; left:60px; transform: rotate(25deg);" %>
      <%= image_tag "sparkle2.webp", class: "position-absolute top-40", style: "max-height: 50px; max-width: 100%;top:-5px; left:-25px;" %>
      Guest
    </span>
  <% end %>
  </div>
</div>
