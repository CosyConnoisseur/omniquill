<div class="page-container m-5 d-flex justify-content-center">
  <div class="character-info-container d-flex align-items-start mt-3">
    <div class="character-portrait-container d-flex flex-column align-items-center">
      <div class="character-portrait torn-edges mb-3">
        <% if @character.portrait.attached? %>
          <%= image_tag @character.portrait, style: "max-height: 550px; border-radius: 8px;" %>
        <% else %>
          <%= image_tag "default-portrait.jpg", style: "max-height: 550px; border-radius: 8px;" %>
        <% end %>
      </div>
      <%= render "characters/form_portrait" %>
    </div>
    <div class="d-flex row">
      <div class="character-text-page-container ms-4 mt-0 bg-white p-5 shadow" style="max-width: 650px; width: 100%;">
        <h1 class="character-title text-center mb-4"><%= @character.name %></h1>
        <div class="summary-container text-center">
          <h2><%= @character.stats_summary  %></h2>
        </div>
      </div>
      <%#= render "characters/form_sheet" %>
      <% if @character.document_upload.attached? %>
        <% if @character.document_upload.content_type == "application/pdf" %>
          <iframe src=<%= url_for(@character.document_upload) %> class="" style="width: 100%; height: 600px; border: none; border-radius: 8px;"></iframe>
          <%= link_to url_for(@character.document_upload), target: "_blank", class: "text-center" do %>
            Download PDF (<%= number_to_human_size(@character.document_upload.byte_size) %>)
          <% end %>
        <% else %>
          <%= image_tag @character.document_upload, style: "max-height: 550px; border-radius: 8px;" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
<p>Find me in app/views/characters/show.html.erb</p>
<div class="bricks-background">
  <div class="centering mt-5">
    <div class="medieval-title position-relative">
      <h1><%= @character.name %></h1>
      <%= link_to edit_character_path(@character),
        class: "position-absolute top-0 end-0 m-3 text-reset" do %>
        <i class="fa-solid fa-pen"></i>
      <% end %>
    </div>
  </div>
  <div class="d-flex flex-column align-items-center">
    <!-- Portrait -->
    <div class="character-portrait-container d-flex flex-column align-items-center mt-4">
      <div class="character-portrait torn-edges mb-3">
        <% if @character.portrait.attached? %>
          <%= image_tag @character.portrait,
              style: "max-height: 550px; max-width: 100%; border-radius: 8px;" %>
        <% else %>
          <%= image_tag "default-portrait.jpg",
              style: "max-height: 550px; max-width: 100%; border-radius: 8px;" %>
        <% end %>
      </div>
      <%= render "characters/form_portrait" %>
    </div>
    <!-- Character description -->
    <div class="parchment-container my-5">
      <div class="d-flex flex-column align-items-center text-center mx-5 font-insert">
        <p><%= @character.stats_summary %></p>
      </div>
    </div>
    <% if @character.document_upload.attached? %>
      <% if @character.document_upload.content_type == "application/pdf" %>
        <iframe src=<%= url_for(@character.document_upload) %> class="" style="width: 100%; height: 600px; border: none; border-radius: 8px;"></iframe>
        <%= link_to url_for(@character.document_upload), target: "_blank", class: "text-center" do %>
          Download PDF (<%= number_to_human_size(@character.document_upload.byte_size) %>)
        <% end %>
      <% else %>
        <%= image_tag @character.document_upload, style: "max-height: 550px; border-radius: 8px;" %>
      <% end %>
    <% end %>
  </div>
</div>
</div>
