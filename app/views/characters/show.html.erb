<% if flash[:white_fade_in] %>
  <div class="page-fade-container"></div>
<% end %>
<script>
  const fadeOutContainer = document.querySelector(".page-fade-container");
    if (fadeOutContainer && !fadeOutContainer.classList.contains("hidden")){

      setTimeout(() => {
        fadeOutContainer.classList.add("hidden");
      }, 50);
    }
</script>
<%# Keep flash and script on top %>
<div class="character-file" data-controller="char-show-tabs sheet-toggle">
  <!-- TAB 1 PROFILE -->
  <div class="character-tab tab-one" data-tab-content="character">
    <div class="char-sheet-top">
      <%= image_tag "dropdown-icon.png", class: "char-sheet-dropdown" %>
      <div class="medieval-title">
        <h1><%= @character.name %></h1>
        <%= link_to edit_character_path(@character),
        class: "edit-character" do %>
          <i class="fa-solid fa-pen"></i>
        <% end %>
      </div>
    </div>
    <div class="char-sheet-bottom">
      <div class="character-portrait">
  </div>
  <div class="d-flex flex-column align-items-center">


<% if policy(@character).show_campaign_link? %>
        <%= link_to "Back to Campaign", :back, class: "btn btn-dark my-2", data: { direction: "back"} %>
      <% end %>

    <!-- Portrait -->
    <div class="character-portrait-container d-flex flex-column align-items-center mt-4">

<div class="page-container d-flex justify-content-center">
    <div class="character-portrait-container d-flex flex-column align-items-center">
      <div class="character-portrait torn-edges mb-3">
        <% if @character.portrait.attached? %>
          <%= image_tag @character.portrait %>
        <% else %>
          <%= image_tag "default-portrait.jpg" %>
        <% end %>
      </div>
    </div>
  </div>
  <!-- TAB 2 DESC -->
  <div class="character-tab tab-two" data-tab-content="description">
    <div class="char-sheet-top">
      <%= image_tag "dropdown-icon.png", class: "char-sheet-dropdown" %>
      <div class="medieval-title">
        <h1><%= @character.name %></h1>
        <%= link_to edit_character_path(@character),
        class: "edit-character" do %>
          <i class="fa-solid fa-pen"></i>
        <% end %>

  <div class="character-info-container d-flex mt-3">
    <div data-controller="sheet-toggle" class="character-show-description">
      <!-- Character description -->
      <div
  class="parchment-container mb-5 character-description-clickable"
  data-action="click->sheet-toggle#open">
        <div class="d-flex flex-column mx-5 font-insert">
          <p style="white-space: pre-wrap;"><%= @character.stats_summary %></p>
        </div>
      </div>
    </div>
    <div class="char-sheet-bottom">
      <div class="parchment-container mb-5 character-description-clickable">
        <div class="font-insert">
          <p><%= @character.stats_summary %></p>
        </div>
      </div>
    </div>
  </div>
  <!-- TAB 3 CHARACTER SHEET MODAL-->
  <div class="character-tab tab-three" data-tab-content="sheet">
    <div class="char-sheet-top">
      <%= image_tag "dropdown-icon.png", class: "char-sheet-dropdown" %>
      <div class="medieval-title">
        <h1><%= @character.name %></h1>
        <%= link_to edit_character_path(@character),
        class: "edit-character" do %>
          <i class="fa-solid fa-pen"></i>
        <% end %>
      </div>
    </div>
    <div class="char-sheet-bottom">
      <% if @character.document_upload.attached? %>
        <% if @character.document_upload.content_type == "application/pdf" %>
          <iframe src=<%= url_for(@character.document_upload) %> class="" style="width: 100%; height: 600px; border: none; border-radius: 8px;"></iframe>
          <%= link_to url_for(@character.document_upload), target: "_blank", class: "text-center" do %>
            Download PDF (<%= number_to_human_size(@character.document_upload.byte_size) %>)
          <% end %>
        <% else %>
          <%= image_tag @character.document_upload,
              class: "character-sheet-image",
              data: {action: "click->sheet-toggle#open"},
              style: "max-height: 550px; object-fit: contain; border-radius: 8px;" %>
 </div>
</div>



<% if @character.document_upload.attached? %>
      <% if @character.document_upload.content_type == "application/pdf" %>
        <iframe src=<%= url_for(@character.document_upload) %> class="" style="width: 100%; height: 600px; border: none; border-radius: 8px;"></iframe>
        <%= link_to url_for(@character.document_upload), target: "_blank", class: "text-center" do %>
          Download PDF (<%= number_to_human_size(@character.document_upload.byte_size) %>)
        <% end %>
      <% end %>
    </div>
  </div>
  <!--  TAB BUTTONS -->
  <div class="character-tabs">
    <button class="char-sheet-tab tab-character"
        type="button"
        data-tab="character"
        data-action="click->char-show-tabs#show">
    </button>
    <button class="char-sheet-tab tab-description"
        type="button"
        data-tab="description"
        data-action="click->char-show-tabs#show">
    </button>
    <button class="char-sheet-tab tab-sheet"
        type="button"
        data-tab="sheet"
        data-action="click->char-show-tabs#show">
    </button>
  </div>
</div>
