<div class="page-container m-5 d-flex justify-content-center">
  <div class="character-info-container d-flex align-items-start mt-3">
    <div class="character-portrait-container d-flex flex-column align-items-center">
      <div class="character-portrait torn-edges mb-3">
        <% if @character.portrait.attached? %>
          <%= image_tag @character.portrait, style: "max-height: 550px; border-radius: 8px;" %>
        <% else %>
          <%= image_tag "default-portrait.jpg", style: "max-height: 550px; border-radius: 8px;" %>
        <% end %>
      </div>
      <%= render "characters/form_portrait" %>
    </div>
    <div class="d-flex row">
      <div class="character-text-page-container ms-4 mt-0 bg-white p-5 shadow" style="max-width: 650px; width: 100%;">
        <h1 class="character-title text-center mb-4"><%= @character.name %></h1>
        <div class="summary-container text-center">
          <h2><%= @character.stats_summary  %></h2>
        </div>
      </div>
      <%#= render "characters/form_sheet" %>
      <% if @character.document_upload.attached? %>
          <%= image_tag @character.document_upload, style: "max-height: 550px; border-radius: 8px;" %>
        <% end %>
    </div>
  </div>
</div>
<p>Find me in app/views/characters/show.html.erb</p>
