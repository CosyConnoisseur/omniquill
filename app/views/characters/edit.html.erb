<div class="character-file" data-controller="char-show-tabs">
  <%= form_with model: @character, class: "character-edit-form" do |f| %>
    <!-- SHARED TOP -->
    <%= render "shared_char_top", f: f, editing: true %>
    <!-- TAB 1: PROFILE -->
    <div class="character-tab tab-one" data-tab-content="character">
      <div class="char-sheet-bottom">
        <div class="character-portrait">
          <%= f.label :portrait, class: "clickable-portrait" do %>
            <% if @character.portrait.attached? %>
              <%= image_tag @character.portrait %>
            <% else %>
              <%= image_tag "default-portrait.jpg" %>
            <% end %>
          <% end %>
          <%= f.file_field :portrait,
              accept: "image/png,image/jpeg,image/jpg,image/webp,image/gif",
              class: "d-none" %>
        </div>
      </div>
    </div>
    <!-- TAB 2: DESCRIPTION -->
    <div class="character-tab tab-two" data-tab-content="description">
      <div class="char-sheet-bottom">
        <div class="parchment-container edit-parchment">
          <%= f.text_area :stats_summary,
              class: "character-description-input",
              rows: 20 %>
        </div>
      </div>
    </div>
    <!-- TAB 3: CHARACTER SHEET -->
    <div class="character-tab tab-three" data-tab-content="sheet">
      <div class="char-sheet-bottom">
        <% if @character.document_upload.attached? %>
          <% if @character.document_upload.content_type == "application/pdf" %>
            <%= link_to url_for(@character.document_upload),
                target: "_blank",
                class: "character-pdf-link" do %>
              Open Character Sheet PDF
            <% end %>
          <% else %>
            <%= image_tag @character.document_upload,
                class: "character-sheet-image" %>
          <% end %>
        <% else %>
          <p>No character sheet uploaded yet.</p>
        <% end %>
        <!-- NEW CHARACTER SHEET -->
        <%= f.file_field :document_upload,
            accept: "application/pdf,image/png,image/jpeg,image/jpg,image/webp",
            class: "d-none",
            id: "character-sheet-upload" %>
        <%= f.label :document_upload,
            "Upload Character Sheet",
            class: "character-sheet-upload-button" %>
      </div>
    </div>
    <!-- TAB BUTTONS -->
    <div class="character-tabs">
      <button
        class="char-sheet-tab tab-character"
        type="button"
        data-tab="character"
        data-action="click->char-show-tabs#show">
      </button>
      <button
        class="char-sheet-tab tab-description"
        type="button"
        data-tab="description"
        data-action="click->char-show-tabs#show">
      </button>
      <button
        class="char-sheet-tab tab-sheet"
        type="button"
        data-tab="sheet"
        data-action="click->char-show-tabs#show">
      </button>
    </div>
  <% end %>
