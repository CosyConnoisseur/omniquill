  <div class="col-md-6 position-relative">
    <%= form_with model: @character, url: campaign_characters_path(@campaign.id), method: :post, local: true, data: { turbo: true, action: "submit->form-typewriter#showLoading" } do |f| %>
      <%= hidden_field_tag :stream_id, @stream_id %>

      <div class="mb-3">
        <%= f.label :document_upload, "Upload Character Sheet(PDF/Image) or Enter Character Details" %>
        <div class="input-group">
        <%= f.file_field :document_upload,
                          accept: 'image/png, image/jpeg, image/jpg, image/webp, image/gif, application/pdf',
                          class: "form-control",
                          data: { form_typewriter_target: "fileField", action: "change->form-typewriter#updateButton change->form-typewriter#previewSheetFile"},
                          required: false %>

        <button class="btn btn-outline-danger d-none"
                type="button"
                data-form-typewriter-target="clearFileButton"
                data-action="click->form-typewriter#clearFile">&times;</button>
      </div>
      </div>

      <div class="mb-3">
        <%= f.label :name, "Character Name" %>
        <%= f.text_field :name,
                          id: "character_name_input",
                          class: "form-control",
                          data: { form_typewriter_target: "nameInput", action: "input->form-typewriter#updateButton" }%>
      </div>

      <div class="mb-3">
        <%= f.label :stats_summary, "Character Description" %>
        <%= f.text_area :stats_summary,
                        id: "character_stats_summary_input",
                        class: "form-control",
                        rows: 6,
                        data: { form_typewriter_target: "descriptionInput", action: "input->form-typewriter#updateButton" }%>
      </div>

      <div class="mb-3">
        <%= f.label :portrait, "Upload Character Portrait (Optional)" %>
      <div class="input-group">
        <%= f.file_field :portrait,
                          accept: "image/png, image/jpeg, image/jpg, image/webp, image/gif",
                          class: " form-control",
                          data: { form_typewriter_target: "portraitField", action: "change->form-typewriter#previewPortraitFile"}%>

        <button class="btn btn-outline-danger d-none"
                type="button"
                data-form-typewriter-target="clearPortraitButton"
                data-action="click->form-typewriter#clearPortraitFile">&times;</button>
      </div>
      </div>

      <!-- Submit -->
      <%= f.submit "Create Character",
                    class: "btn btn-primary w-75",
                    data: { form_typewriter_target: "submitButton"} %>

      <!-- AI button -->
      <button type="submit"
              class="btn btn-info w-75 d-none"
              data-form-typewriter-target="aiButton">
              Generate From Character Sheet
      </button>

      <!-- Loading -->
      <button type="button"
          class="btn btn-secondary w-75 d-none"
          disabled
          data-form-typewriter-target="loadingButton">
      <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
      Generating...
      </button>

      <!-- Clear Text -->
      <button type="button"
              class="btn btn-warning flex-shrink-0 d-none"
              title="Clear text"
              data-form-typewriter-target="clearTextButton"
              data-action="click->form-typewriter#clearText">
      Clear Text
      </button>
    <% end %>
<div data-form-typewriter-target="previewContainer" class="d-none position-absolute top-0 preview-left-margin" style="height: 450px; width: 450px;  overflow: hidden;">
  <img data-form-typewriter-target="imagePreview" src="" class="" style="height: 100%; width: 100%; object-fit: contain;">
  <iframe data-form-typewriter-target="pdfPreview" src="" style="height: 100%; width: 100%;" class=""></iframe>
</div>

<div data-form-typewriter-target="portraitPreviewContainer" class="d-none position-absolute top-0 preview-right-margin" style="height: 450px; width: 450px; overflow: hidden;">
  <img data-form-typewriter-target="portraitPreview" src="" class="" style="height: 100%; width: 100%; object-fit: contain;">
</div>
  </div>
