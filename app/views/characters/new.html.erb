<div class="page-fade-container hidden"></div>


<%# <div class="parchment-container my-5">  search -> tabs -> character show again -> index -> campaign show [phone phone phone] transitions %>



<div class="w-md-75 mx-md-5">
<div class="parchment-container my-3 mx-0 w-100 w-md-75">
  <h1 class="text-center" style="font-family: 'Jacquarda Bastarda 9'; font-size: 1.4rem; -webkit-text-stroke: 1px black; text-shadow: 2px 2px 0px rgba(0,0,0,0.2);">Create a New Character</h1>
    <h2 class="text-center" style="font-family: 'Jacquarda Bastarda 9'; font-size: 1.4rem; -webkit-text-stroke: 1px black; text-shadow: 2px 2px 0px rgba(0,0,0,0.2);">Or</h2>

    <h2 class="text-center"
    style="font-family: 'Jacquarda Bastarda 9';
    font-size: 1.4rem;
    -webkit-text-stroke: 1px black;
    text-shadow: 2px 2px 0px rgba(0,0,0,0.2);">
    <span class="magic-text position-relative", style="font-family: 'Jersey 15';font-size: 2.5rem;">
      <%= image_tag "sparkle.webp", class: "position-absolute top-40", style: "max-height: 50px; max-width: 100%; top:10px; left:95px; transform: rotate(25deg);" %>
      <%= image_tag "sparkle2.webp", class: "position-absolute top-40", style: "max-height: 50px; max-width: 100%;top:-10px; left:-20px;" %>
      Auto-Fill
      </span>
      one from a Character Sheet</h2>

  <div data-controller="form-typewriter" class="container border-top pt-1 pb-5" style="border-top-color: #645a1a !important;">
  <%= turbo_stream_from "character_generation_#{@stream_id}" %>
    <div class="row justify-content-center">
  <%= render "form_sheet", character: @character, stream_id: @stream_id %>

      <!-- The controller targets this to stream text -->
      <div id="live_typewriter_output" data-form-typewriter-target="buffer" class="bg-dark text-light d-none">
      </div>
    </div>
  </div>

</div>
</div>
