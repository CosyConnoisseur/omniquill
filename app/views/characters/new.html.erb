<h1>Characters#new</h1>
<%# <%= turbo_stream_from "character_generation_#{@stream_id}" %> %>
<%= render "form_sheet" %> %>

<p>Add character Portrait</p>

<!-- 1. Establish the real-time listening channel using the token from the controller -->
<%= turbo_stream_from "character_generation_#{@stream_id}" %>

<div class="row">
  <!-- Left Side: The Form -->
  <div class="col-md-6">
    <!-- data: { turbo: true } ensures the form uploads asynchronously -->
    <%= form_with model: @character, url: parse_sheet_characters_path, method: :post, local: true, data: { turbo: true } do |f| %>

      <div class="mb-3">
        <%= f.label :document_upload, "Upload Character Sheet (PDF/Image)" %>
        <%= f.file_field :document_upload, class: "form-control", required: true %>
      </div>

      <!-- Visible Form Inputs that will be auto-filled after AI finishes -->
      <div class="mb-3">
        <%= f.label :name, "Character Name" %>
        <%= f.text_field :name,
                          id: "character_name_input",
                          class: "form-control",
                          data: { form_typewriter_target: "nameInput" }%>
      </div>

      <div class="mb-3">
        <%= f.label :stats_summary, "Character Description" %>
        <%= f.text_area :stats_summary,
                        id: "character_stats_summary_input",
                        class: "form-control",
                        rows: 6,
                        data: { form_typewriter_target: "descriptionInput" } %>
      </div>
        <%= hidden_field_tag :stream_id, @stream_id %>
      <%= f.submit "Upload & Analyze with AI", class: "btn btn-primary" %>
    <% end %>
  </div>

  <!-- Right Side: The Real-time AI Stream Box -->
  <div class="col-md-6">
    <h5>AI Analysis Stream</h5>
    <!-- The controller targets this exact ID to stream text into -->
    <div id="live_typewriter_output" class="border p-3 bg-dark text-light font-monospace rounded" style="min-height: 200px; white-space: pre-wrap;">
      <span class="text-muted">Upload a sheet to begin AI generation...</span>
    </div>
  </div>
</div>


<p>Find me in app/views/characters/new.html.erb</p>



<script>
  document.addEventListener("turbo:load", () => {
    const buffer = document.getElementById("live_typewriter_output");
    const nameInput = document.getElementById("character_name_input");
    const descInput = document.getElementById("character_stats_summary_input");

    if (!buffer || !nameInput || !descInput) return;

    console.log("Fallback typewriter listener safely connected!");

    const observer = new MutationObserver(() => {
      const rawText = buffer.innerText;

      // 1. Fixed Regex: Added [1] to pull just the captured group text
      // Added (\*|_)* to cleanly bypass any bolding like **NAME:** from the AI
      const nameMatch = rawText.match(/NAME:\s*([^\n\r]*)/i);
      const descMatch = rawText.match(/DESCRIPTION:\s*([\s\S]*)/i);

      // 2. Safely extract index 1 (the text inside the capture parentheses)
      if (nameMatch && nameMatch[1]) {
        // Strip out trailing markdown asterisks if the AI wrapped the row
        nameInput.value = nameMatch[1].replace(/[\*\#_\[\]]/g, "").trim();
      }

      if (descMatch && descMatch[1]) {
        descInput.value = descMatch[1].trim();
      }
    });

    observer.observe(buffer, { textContent: true, childList: true, subtree: true });
  });
</script>
