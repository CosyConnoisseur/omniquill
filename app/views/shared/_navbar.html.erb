<nav class="navbar nev navbar-expand-sm navbar-light navbar-lewagon">
  <div class="container-fluid">

    <%= link_to root_path, class: "navbar-brand" do %>
      <%= image_tag "Omniquill-logo.png" %>
    <% end %>

    <!-- Ben Fix: Middle Logo (added d-inline-block to keep it in the row flow) -->
    <%= link_to root_path, class: "d-inline-block alignment-fix" do %>
      <%= image_tag "Full-logo.png", class: "navbar-logo", style: "max-width: 40vw; max-height: 40px; width: auto; object-fit: contain; vertical-align: middle;" %>
    <% end %>

    <!-- Ben Fix: Right Dropdown Toggler Button (added d-inline-block) -->
    <div class="btn border-0 bg-transparent navbar-toggler d-sm-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class=""><%= image_tag "dropdown-icon", alt: "dropdown menu", id: "bookmark-dropdown", style: "width: 50px; vertical-align: middle;"%></span>
    </div>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto horizontal-items">
        <% if user_signed_in? %>
          <li class="nav-item active mx-2">
            <%= link_to root_path do %>
              <button class="navbar-home-button"></button>
            <% end %>
          </li>
          <% if current_page?("") || controller_name == 'campaigns' && action_name == 'index' %>
            <li class="nav-item active mx-2">
              <%= link_to new_campaign_path do %>
                <button class="navbar-create-campaign-button"></button>
              <% end %>
            </li>
            <% end %>
            <% if controller_name == 'campaigns' && action_name == 'show' %>
              <% if current_user.id == @campaign.user_id %>
              <li class="nav-item active mx-2">
                <%= link_to record_campaign_path(@campaign) do %>
                  <button class="navbar-create-chapter-button"></button>
                <% end %>
              <% end %>
              </li>
            <% end %>
            <% if controller_name == 'campaigns' && action_name == 'show' %>
              <% if current_user.id == @campaign.user_id %>
              <li class="nav-item active mx-2">
                <%= button_to campaign_path(@campaign),
                method: :delete,
                class: "navbar-delete-campaign-button",
                data: { turbo_confirm: "Delete this campaign?" } do %>
                <% end %> <%# This might be empty, but it's needed to actually make the icon appear. DON'T delete this 'do/end' %>
              <% end %>
              </li>
            <% end %>
          <li class="nav-item dropdown mx-2">
          <a href="#" class="avatar" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <% if current_user.profile_picture.attached? %>
              <%= image_tag current_user.profile_picture, class: "avatar", alt: "dropdown menu", style: "height: 50px; width: 50px; object-fit: cover" %>
            <% else %>
              <%= image_tag "default-avatar.png", class: "avatar", alt: "dropdown menu", style: "height: 50px; width: 50px; object-fit: cover" %>
            <% end %>
          </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <%= link_to "Edit User", edit_user_registration_path, class: "dropdown-item" %>
              <%= link_to "Log out", destroy_user_session_path, data: {turbo_method: :delete}, class: "dropdown-item" %>
            </div>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Login", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
