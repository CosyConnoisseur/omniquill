<%= simple_form_for([campaign, chapter]) do |f| %>
  <%= f.input :title, placeholder: chapter.title, input_html: { class: "edit-input-box" }, label_html: {style: "font-size: 3rem; color: #00a2ff; text-shadow: 1px 1px 3px rgb(164, 214, 255);"} %>
  <%= f.input :summary, placeholder: chapter.summary, input_html: { class: "edit-input-box", style: "height: 300px;" }, label_html: {style: "font-size: 3rem; color: #00a2ff; text-shadow: 1px 1px 3px rgb(164, 214, 255);"} %>
  <%= f.input :highlights, placeholder: chapter.highlights, input_html: { class: "edit-input-box" }, label_html: {style: "font-size: 3rem; color: #00a2ff; text-shadow: 1px 1px 3px rgb(164, 214, 255);"} %>
  <div class="centering">
    <%= f.button :submit, "", class: "edit-submit-button" %>
    <%= link_to campaign_chapter_path(@campaign, @chapter), data: { direction: "back" } do %>
      <button class="back-button" style="width: 5rem; height: 5rem;"></button>
    <% end %>
  </div>
<% end %>
