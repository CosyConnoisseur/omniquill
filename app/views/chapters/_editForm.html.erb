<%= simple_form_for([campaign, chapter]) do |f| %>
  <%= f.input :title, placeholder: chapter.title, input_html: {style: "background-color: #b09c71;"}, label_html: {style: "font-family: 'Marck Script'; font-size: 3rem; color: #00a2ff;"} %>
  <%= f.input :summary, placeholder: chapter.summary, input_html: {style: "height: 300px; background-color: #b09c71;"}, label_html: {style: "font-family: 'Marck Script'; font-size: 3rem; color: #00a2ff;"} %>
  <%= f.input :highlights, placeholder: chapter.highlights, input_html: {style: "background-color: #b09c71;"}, label_html: {style: "font-family: 'Marck Script'; font-size: 3rem; color: #00a2ff;"} %>
  <%= f.button :submit, "", class: "edit-submit-button" %>
<% end %>
