<div class="bricks-background">
  <div class="centering">
    <div class="medieval-title">
      <h1><%= @campaign.title %></h1>
    </div>
  </div>

  <div class="centering">
    <div class="parchment-container">
      <% @chapters.each do |chapter| %>
        <div class="chap-card">
          <%= link_to campaign_chapter_path(@campaign, chapter) do %>
            <p class="fs-3"><%= chapter.title %></p>
          <% end %>
          <p><%= chapter.summary.split(". ")[0] %>...</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
