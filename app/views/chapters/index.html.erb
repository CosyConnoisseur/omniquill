<div class="centering">
  <div class="medieval-title">
    <h1><%= @campaign.title %></h1>
  </div>
</div>

<div class="centering">
  <div class="book-page-container">
    <% if @chapters.empty? %>
      <p id="no-chapters">No adventures...yet</p>
    <% else %>
      <% @chapters.reverse.each do |chapter| %>
        <div class="chap-card">
          <div class="d-flex justify-content-end">
            <p class="chap-date">
              <%= chapter.created_at.strftime("%B %d, %Y") %> |
              <%= time_ago_in_words(chapter.created_at) %> ago
            </p>
          </div>
          <%= link_to campaign_chapter_path(@campaign, chapter) do %>
            <p class="chap-title"><%= chapter.title %></p>
          <% preview = [] %>
          <% chapter.summary.split(" ").each_with_index do |word, index| %>
            <% if index == 16 %>
              <% break %>
            <% else %>
              <% preview << word %>
            <% end %>
          <% end %>
          <p><%= preview.join(" ") %>...</p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
<div class="d-flex justify-content-center my-4">
  <%= link_to campaign_path(@campaign), class: "animate-button" do %>
    <%= image_tag "back-icon.png", class: "animate-icon" %>
    <%= image_tag "back-icon.gif",  class: "animate-move-icon" %>
  <% end %>
</div>
