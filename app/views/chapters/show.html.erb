<div class="bricks-background">
  <div class="centering mt-5">
    <div class="medieval-title">
      <h1><%= @chapter.title %></h1>
    </div>
  </div>
  <div class="centering">
    <div class="parchment-container">

      <div class="d-flex flex-column align-items-center text-center mx-5 p-3 font-insert">
        <p><%= @chapter.summary %></p>
        <ul>
          <% @chapter.highlights.split(", ").each do |highlight| %>
          <li><%= highlight %></li>
          <% end %>
        </ul>
        <div class="d-flex justify-content-center">
          <% if current_user.participations.where(campaign_id: @campaign.id).present? || current_user.campaigns.exists?(id: @campaign.id) %>
            <%= link_to edit_campaign_chapter_path(@campaign, @chapter), class: "edit-button" do %>
              <%= image_tag "Edit-icon.png", class: "edit-icon" %>
              <%= image_tag "Edit-icon.gif",  class: "edit-move-icon" %>
            <% end %>
          <% end %>
          <%= link_to campaign_chapters_path, class: "home-button" do %>
            <%= image_tag "Home-icon.png", class: "home-icon" %>
            <%= image_tag "Home-icon.gif",  class: "home-move-icon" %>
          <% end %>
        </div>
      </div>

      <div class="d-flex justify-content-between mx-5">
        <% if current_user.participations.where(campaign_id: @campaign.id).present? || current_user.campaigns.exists?(id: @campaign.id) %>
          <%= link_to new_campaign_chapter_sticky_path(@campaign, @chapter) do %>
            <button class="btn btn-info">Sticky!</button>
          <% end %>
        <% end %>
        <ul>
          <% @chapter.stickies.each do |sticky| %>
            <li><%= sticky.text %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
