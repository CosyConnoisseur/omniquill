<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Omniquill" %></title>

    <!--Mobile Scaling-->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Omniquill">
    <meta name="mobile-web-app-capable" content="yes">

    <!--Security Tags-->
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <!--Page animations/transitions-->
    <meta name="view-transition" content="same-origin" />



    <!--Icons-->
    <link rel="icon" type="image/svg+xml" href=<%= asset_url("favicon.svg") %> />
    <link rel="icon" type="image/png" href=<%= asset_url("favicon-96x96.png") %> sizes="96x96" />
    <link rel="shortcut icon" href=<%= asset_url("favicon.ico") %> />
    <link rel="apple-touch-icon" sizes="180x180" href=<%= asset_url("apple-touch-icon.png") %> />





    <!--Bootstrap and google fonts-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=Happy+Monkey&family=IM+Fell+English:ital@0;1&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Jacquard+12&family=Jacquarda+Bastarda+9&family=Jersey+10&family=Jersey+15&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Orbitron:wght@400..900&family=Pixelify+Sans:wght@400..700&family=Press+Start+2P&family=Silkscreen:wght@400;700&family=VT323&display=swap" rel="stylesheet">


    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!--redundant and conflicting-->
    <%# <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-title" content="Omniquill" /> %>

  </head>



  <body><%= render "shared/navbar" %>
    <%= render "shared/flashes" %>

    <%= yield %>
    <div
      id="processing-box"
      data-controller="processing"
      data-turbo-permanent
      data-processing-target="alert"
      class="position-fixed bottom-0 start-0 m-4 p-3 bg-light border rounded shadow d-none"
      style="z-index: 1050; width: 260px; max-width: calc(100vw - 2rem);"
    >
      <div data-processing-target="message">
        Preparing...
      </div>

      <div data-processing-target="progress" class="small mt-1">
      </div>

      <div data-processing-target="timer" class="small mt-1">
        00:00:00
      </div>

      <div class="mt-2">
        <%= link_to "View Chapter",
            "#",
            data: {
              processing_target: "chapterLink",
              action: "click->processing#viewChapter"
            },
            class: "btn btn-sm btn-outline-secondary d-none"
        %>
      </div>

      <button
        type="button"
        data-processing-target="cancelButton"
        data-action="click->processing#cancel"
        class="btn btn-sm btn-outline-danger"
      >
        Cancel
      </button>

      <button
        type="button"
        data-processing-target="closeButton"
        data-action="click->processing#close"
        class="btn-close position-absolute top-0 end-0 m-2"
        aria-label="Close"
      ></button>
    </div>
  </body>
</html>
