<% owner = current_user.id == @campaign.user_id %>

<!-- Banner, title, delete, record -->

<div class="py-5" style="background-image: linear-gradient(rgba(0,0,0,0.4)), url('<%= @campaign.banner.attached? ? url_for(@campaign.banner)  : asset_path("wp2820152-mtg-wallpaper.jpg") %>'); min-height: 200px; background-size: cover; background-position: center">
  <div class="container d-flex flex-row justify-content-between text-white">
    <% if owner %>
      <%= form_with model: @campaign, id: "banner-upload-form" do |form| %>
        <%= form.file_field :banner,
            id: "banner-upload",
            style: "display: none;",
            accept: "image/*",
            onchange: "document.getElementById('banner-upload-form').requestSubmit();" %>
          <label for="banner-upload" class="text-white clickable-icon" style="cursor: pointer;">
            <svg width="40" height="40" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
              <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
            </svg>
          </label>
        <% end %>
      <% end %>
    <div class="mt-auto">
      <% if owner %>
        <%= button_to campaign_path(@campaign), method: :delete, class: "text-reset clickable-icon", data: { turbo_confirm: "Delete this campaign?" }, style: "background: none; border: none; padding: 0;" do %>
          <svg width="40" height="40" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-trash3-fill" viewBox="0 0 16 16">
            <path d="M11 1.5v1h3.5a.5.5 0 0 1 0 1h-.538l-.853 10.66A2 2 0 0 1 11.115 16h-6.23a2 2 0 0 1-1.994-1.84L2.038 3.5H1.5a.5.5 0 0 1 0-1H5v-1A1.5 1.5 0 0 1 6.5 0h3A1.5 1.5 0 0 1 11 1.5m-5 0v1h4v-1a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5M4.5 5.029l.5 8.5a.5.5 0 1 0 .998-.06l-.5-8.5a.5.5 0 1 0-.998.06m6.53-.528a.5.5 0 0 0-.528.47l-.5 8.5a.5.5 0 0 0 .998.058l.5-8.5a.5.5 0 0 0-.47-.528M8 4.5a.5.5 0 0 0-.5.5v8.5a.5.5 0 0 0 1 0V5a.5.5 0 0 0-.5-.5"/>
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="container d-flex flex-row justify-content-between text-white" style="height: 150px;">
    <% if owner %>
      <div class="mt-auto">
        <div id="title-display">
          <h1 style="cursor: pointer;" onclick="document.getElementById('title-display').style.display = 'none'; document.getElementById('title-edit').style.display ='block';">
            <%= @campaign.title %>
          </h1>
        </div>
        <div id="title-edit" style="display: none;">
          <%= form_with model: @campaign do |form| %>
            <div class="d-flex align-items-center gap-2">
              <%= form.text_field :title, class: "form-control" %>
              <%= form.submit "Save", class: "btn btn-secondary"%>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <h1 class="mt-auto"><%= @campaign.title %></h1>
    <% end %>
    <% if owner %>
      <div class="mt-auto">
        <%= link_to record_campaign_path(@campaign), class: "text-reset clickable-icon" do %>
          <svg width="40" height="40" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-mic-fill" viewBox="0 0 16 16">
            <path d="M5 3a3 3 0 0 1 6 0v5a3 3 0 0 1-6 0z"/>
            <path d="M3.5 6.5A.5.5 0 0 1 4 7v1a4 4 0 0 0 8 0V7a.5.5 0 0 1 1 0v1a5 5 0 0 1-4.5 4.975V15h3a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1h3v-2.025A5 5 0 0 1 3 8V7a.5.5 0 0 1 .5-.5"/>
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Row Bar -->

<div class="row w-100 align-items-stretch g-0">
  <div class="col-3">
    <div class="p-3 d-flex flex-column justify-content-center align-items-center border rounded shadow-sm h-100">
      <button onclick="handleCharListClick()" class="btn clickable-icon" >
        <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16">
          <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>
        </svg>
      </button>
      <script>
        function handleCharListClick() {
          const dialog = document.getElementById('charListPopup');
          dialog.showModal(); // Opens the dialog natively HTML text, open a modal, etc.
        }
      </script>
      <script>
        document.addEventListener("turbo:before-cache", () => {
          const dialog = document.getElementById("charListPopup");
          if (dialog && dialog.open) {
            dialog.close();
          }
        });
      </script>
      <h1><%= @campaign.participations.count %></h1>
      <p class="m-0 lh-1"> Players </p>
    </div>
  </div>
  <div class="col-3">
    <div class="p-3 d-flex flex-column justify-content-center align-items-center border rounded shadow-sm h-100">
      <%= link_to campaign_chapters_path(@campaign) do %>
      <button onclick="handleChapterListClick()" class="btn clickable-icon" >
        <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-list-ol" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5"/>
          <path d="M1.713 11.865v-.474H2c.217 0 .363-.137.363-.317 0-.185-.158-.31-.361-.31-.223 0-.367.152-.373.31h-.59c.016-.467.373-.787.986-.787.588-.002.954.291.957.703a.595.595 0 0 1-.492.594v.033a.615.615 0 0 1 .569.631c.003.533-.502.8-1.051.8-.656 0-1-.37-1.008-.794h.582c.008.178.186.306.422.309.254 0 .424-.145.422-.35-.002-.195-.155-.348-.414-.348h-.3zm-.004-4.699h-.604v-.035c0-.408.295-.844.958-.844.583 0 .96.326.96.756 0 .389-.257.617-.476.848l-.537.572v.03h1.054V9H1.143v-.395l.957-.99c.138-.142.293-.304.293-.508 0-.18-.147-.32-.342-.32a.33.33 0 0 0-.342.338zM2.564 5h-.635V2.924h-.031l-.598.42v-.567l.629-.443h.635z"/>
        </svg>
      </button>
      <% end %>
      <h1><%= @campaign.chapters.count %></h1>
      <p class="m-0 lh-1"> Chapters </p>
    </div>
  </div>
  <div class="col-3">
    <div class="p-3 d-flex flex-column justify-content-center align-items-center border rounded shadow-sm h-100">
      <button onclick="handleNoteListClick()" class="btn clickable-icon" >
        <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-file-text-fill" viewBox="0 0 16 16">
          <path d="M12 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2M5 4h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1 0-1m-.5 2.5A.5.5 0 0 1 5 6h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5M5 8h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1 0-1m0 2h3a.5.5 0 0 1 0 1H5a.5.5 0 0 1 0-1"/>
        </svg>
      </button>
      <script>
        function handleNoteListClick() {
          const dialog = document.getElementById('noteListPopup');
          dialog.showModal();
        }
      </script>
      <h1><%= @campaign.notes.count %></h1>
      <p class="m-0 lh-1"> Notes </p>
    </div>
  </div>
  <div class="col-3">
    <div class="p-3 d-flex flex-column justify-content-center align-items-center border rounded shadow-sm h-100">
      <%= link_to "#", class: "text-reset clickable-icon" do %>
        <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
          <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
          <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
        </svg>
      <% end %>
      <h3 style="margin-top: 15px; margin-bottom: 10px;"><%= @campaign.user&.username %></h3>
      <p class="m-0 lh-1"> DM </p>
    </div>
  </div>
</div>
<div>
  <div class="justify-content-center h-100 py-4 px-4 text-black">
    <% if owner %>

      <div id="synopsis-display">
        <p class="mt-auto">
          <%= @campaign.synopsis %>
          <button
            type="button"
            class="btn btn-link"
            onclick="document.getElementById('synopsis-edit').style.display = 'block'; document.getElementById('synopsis-display').style.display = 'none';">
            Edit
          </button>
        </p>
      </div>

      <div id="synopsis-edit" style="display: none;">
        <%= form_with model: @campaign do |form| %>
          <%= form.text_area :synopsis, class: "form-control w-100", rows: 8 %>
          <%= form.submit "Save", class: "btn btn-primary btn-sm rounded-3" %>
          <button
            type="button"
            class="btn btn-secondary btn-sm rounded-3"
            onclick="document.getElementById('synopsis-edit').style.display = 'none'; document.getElementById('synopsis-display').style.display = 'block';">
            Cancel
          </button>
        <% end %>
      </div>
    <% else %>
      <p class="mt-auto"><%= @campaign.synopsis %></p>
    <% end %>
  </div>
</div>

<!-- char-list-dialog -->
<%# Testing if characters attached to campaigns correctly %>
<% @campaign.characters.each do |character| %>
  <div class="col-md-4 mb-3">
    <%= link_to character_path(character), class: "text-decoration-none" do %>
      <div class="card shadow-sm" style="border-radius: 5px; background-color: transparent;">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <h5 class="card-title">
              <%= character.name %>
            </h5>
            <% if character.portrait.attached? %>
              <%= image_tag character.portrait, style: "width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" %>
            <% else %>
              <%= image_tag "default-portrait.jpg", style: "max-height: 70px; border-radius: 8px;" %>
            <% end %>
          </div>
          <p class="card-text text-muted">
            Played by: <%= character.participation.user.username ? character.participation.user.username : character.participation.user.email  %>
                      <% if character.participation.user.profile_picture.attached? %>
                        <%= image_tag character.participation.user.profile_picture, class: "avatar", style: "height: 50px; width: 50px; object-fit: cover" %>
                      <% else %>
                        <%= image_tag "default-avatar.png", class: "avatar", style: "height: 50px; width: 50px; object-fit: cover"%>
                      <% end %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= link_to "Create New Character", new_campaign_character_path(@campaign.id), class: "btn btn-primary ms-3" %>
<% end %>

<dialog id="charListPopup">
  <ul style="list-style-type: none; padding-left: 0;">
    <div class="container d-flex flex-column">
      <% @characters.each do |character| %>
      <div class="container d-flex flex-row gap-4 align-items-center" style="padding: 10px 0;">
        <% if character.portrait.attached? %>
          <%= image_tag character.portrait, style: "width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" %>
        <% else %>
          <%= image_tag "default-portrait.jpg", style: "max-height: 70px; border-radius: 8px;" %>
        <% end %>
        <li>
          <h5>
          <%= link_to character_path(character), class: "text-reset", style: "outline: none; box-shadow: none;" do %>
            <%= character.name %>
          <% end %>
          </h5>
          <p class="card-text text-muted">
            Played by: <%= character.participation.user.email %>
          </p>
        </li>
      </div>
      <% end %>
    </div>
  </ul>
  <div class="container d-flex flex-row justify-content-between">
    <%= link_to new_campaign_character_path(@campaign.id), class: "text-reset clickable-icon" do %>
      <svg width="40" height="40" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-plus-fill" viewBox="0 0 16 16">
        <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
        <path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5"/>
      </svg>
    <% end %>
      <button
      onclick="document.getElementById('charListPopup').close()"
      style="background: none; border: none; outline: none; color: #ef4444; padding: 0; margin: 0; cursor: pointer; font-size: 40px;">
        &#x2715;
      </button>
  </div>
</dialog>

<!-- chapter-list-dialog -->

<dialog id="chapterListPopup">
  <ul style="list-style-type: none; padding-left: 0;">
    <div class="container d-flex flex-column">
      <% @chapters.each do |chapter| %>
        <div class="container d-flex flex-row gap-4 align-items-center" style="padding: 10px 0;">
          <li>
            <div class="card rounded-3">
              <div class="card-body">
                <div class="container d-flex flex-column rounded-3 justify-content-end text-white" style="background-image: linear-gradient(rgba(0,0,0,0.4)), url('<%= asset_path("wp2820152-mtg-wallpaper.jpg") %>'); min-height: 150px; background-size: cover; background-position: center">
                  <%= link_to "#", class: "text-reset mt-auto", style: "outline: none; box-shadow: none;" do %>
                    <h2 class="mx-3 my-3" ><%= chapter.title %></h2>
                  <% end %>
                </div>
                <details class="summary-toggle my-3">
                  <summary>
                    <%= truncate(chapter.summary, length: 200) %>
                  </summary>
                  <p class="full-text"><%= chapter.summary %></p>
                </details>
              </div>
            </div>
          </li>
        </div>
      <% end %>
    </div>
  </ul>
  <div style="display: flex; justify-content: center; width: 100%;">
    <button
    onclick="document.getElementById('chapterListPopup').close()"
    style="background: none; border: none; outline: none; color: #ef4444; padding: 0; margin: 0; cursor: pointer; font-size: 40px;">
      &#x2715;
    </button>
  </div>
</dialog>

<!-- note-list-dialog -->

<dialog id="noteListPopup">
  <ul style="list-style-type: none; padding-left: 0;">
    <div class="container d-flex flex-column" style="background-color: #ffffffa0">
      <% @notes.each do |note| %>
        <div class="container d-flex flex-row gap-4 align-items-center" style="margin: 10px auto; padding: 10px; background-color: #ffffff; border: 1px solid #e0e0e0; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
          <svg width="48" height="48" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-card-text" viewBox="0 0 16 16">
            <path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2z"/>
            <path d="M3 5.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5M3 8a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 8m0 2.5a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5"/>
          </svg>
          <!-- Show Notes -->
          <li class="flex-grow-1">
            <h2><%= note.entry %></h2>
          </li>
          <!-- Delete Note -->
          <% if owner %>
            <%= button_to campaign_note_path(@campaign, note),
                method: :delete,
                class: "btn",
                style: "color: red; font-size: 30px;",
                data: { turbo_confirm: "Delete this note?" } do %>
              &#x2715;
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </ul>

  <!-- Add a note -->
  <% if current_user.id == @campaign.user_id %>
  <div id="add-note-button" style="display: flex; justify-content: center; margin-bottom: 20px;">
    <button
      type="button"
      class="btn btn-link"
      onclick="document.getElementById('add-note-form').style.display = 'block'; document.getElementById('add-note-button').style.display = 'none';">
      + Add note
    </button>
  </div>

  <div id="add-note-form" style="display: none;">
    <%= form_with model: [@campaign, @campaign.notes.build] do |form| %>
      <%= form.text_area :entry,
          class: "form-control",
          rows: 4,
          placeholder: "Write a note..." %>
      <%= form.submit "Save", class: "btn btn-primary" %>
      <button
        type="button"
        class="btn btn-secondary mt-2"
        onclick="document.getElementById('add-note-form').style.display = 'none'; document.getElementById('add-note-button').style.display = 'flex';">
        Cancel
      </button>
    <% end %>
  </div>
  <% end %>

  <div style="display: flex; justify-content: center; width: 100%">
    <button
      onclick="document.getElementById('noteListPopup').close()"
      style="background: none; border: none; outline: none; color: #ef4444; padding: 0; margin: 0; cursor: pointer; font-size: 40px;">
      &#x2715;
    </button>
  </div>
</dialog>
