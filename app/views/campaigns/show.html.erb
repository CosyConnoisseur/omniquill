<% owner = current_user.id == @campaign.user_id %>

<!-- record button -->
<% if owner %>
  <%= link_to record_campaign_path(@campaign), class: "bottom-fix-button" do %>
    <button class="create-chapter-fixed-button"></button>
  <% end %>
<% end %>

<!-- banner -->
<% if @campaign.banner.attached? %>
  <% image_url = url_for(@campaign.banner)  %>
<% elsif @campaign.card_image.attached? %>
  <% image_url = url_for(@campaign.card_image)  %>
<% else %>
  <% image_url = asset_path("wp2820152-mtg-wallpaper.jpg") %>
<% end %>

<div class="position-relative py-5 banner-hover-container" style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('<%= image_url %>'); min-height: 350px; background-size: cover; background-position: center;">
  <div class="container d-flex flex-row justify-content-between text-white">
    <% if owner %>
      <%= form_with scope: :campaign, url: campaign_path(@campaign), method: :patch, id: "banner-upload-form" do |form| %>
        <%= form.file_field :banner,
            id: "banner-upload",
            style: "display: none;",
            accept: "image/*",
            onchange: "document.getElementById('banner-upload-form').requestSubmit();" %>

        <!-- no pointer events -->
        <label for="banner-upload" class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center m-0" style="cursor: default; pointer-events: none;">

          <!--  this button area accepts mouse clicks -->
          <span class="btn btn-dark opacity-0 banner-upload-btn shadow position-absolute" style="top: 4px; left: 10px; transition: all 0.2s ease-in-out; pointer-events: auto; cursor: pointer; background-color: rgba(0,0,0,0.8); border-color: rgba(255,255,255,0.5);">
            Change Banner
          </span>

        </label>
      <% end %>
    <% end %>

    <!-- title content container -->

  <div class="container d-flex flex-column align-items-center justify-content-center text-white position-absolute start-50 top-50 translate-middle w-md-100 col-md-8 col-lg-6">
      <% if owner %>
        <div class="w-100">
          <div id="title-display">
            <h1 class="text-center m-0" style="cursor: pointer; font-family: 'Jersey 15'; font-size: 3.5rem; text-transform: uppercase; letter-spacing: 3px; text-shadow: 3px 3px 0px #000000; color: #ffffff;" onclick="document.getElementById('title-display').style.display = 'none'; document.getElementById('title-edit').style.display ='block';">
              <%= @campaign.title %>
            </h1>
          </div>
          <div id="title-edit" style="display: none;">
            <%= form_with model: @campaign do |form| %>
              <div class="d-flex align-items-center gap-2">
                <%= form.text_field :title, class: "form-control" %>
                <%= form.submit "Save", class: "btn btn-secondary"%>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="w-100">
            <div id="title-display">
          <h1 class="text-center m-0" style="cursor: pointer; font-family: 'Jersey 15'; font-size: 3.5rem; text-transform: uppercase; letter-spacing: 3px; text-shadow: 3px 3px 0px #000000; color: #ffffff;"><%= @campaign.title %></h1>
            </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Tabs -->
<div class="parchment-container mb-5" style="min-height: 1000px; width:100%;">
  <% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<div class="campaign-file" data-controller="campaign-show-tabs"
      data-campaign-show-tabs-campaign-id-value="<%= @campaign.id %>">
<!-- Tab Navigation -->
  <nav class="nav nav-tabs justify-content-center nav-justified" id="myTab" role="tablist" data-action="shown.bs.tab->campaign-show-tabs#saveTab">
    <button class="nav-link active text-dark campaign-tab tab-one" data-tab-content="synopsis" id="synopsis-tab" data-bs-toggle="tab" data-bs-target="#synopsis-pane" type="button" role="tab" aria-controls="synopsis-pane" aria-selected="true">
      Synopsis <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-file-text-fill d-block mx-auto" viewBox="0 0 16 16">
                <path d="M12 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2M5 4h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1 0-1m-.5 2.5A.5.5 0 0 1 5 6h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5M5 8h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1 0-1m0 2h3a.5.5 0 0 1 0 1H5a.5.5 0 0 1 0-1"/>
              </svg>
      </button>

    <button class="nav-link text-dark campaign-tab tab-two" data-tab-content="characters" id="characters-tab" data-bs-toggle="tab" data-bs-target="#characters-pane" type="button" role="tab" aria-controls="characters-pane" aria-selected="false">
      Characters <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-people-fill d-block mx-auto" viewBox="0 0 16 16">
                  <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>
                </svg>
    </button>

    <button class="nav-link text-dark w-100 campaign-tab tab-three" data-tab-content="notes" id="notes-tab" data-bs-toggle="tab" data-bs-target="#notes-pane" type="button" role="tab" aria-controls="notes-pane" aria-selected="false">
      Notes <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-pencil-fill d-block mx-auto" viewBox="0 0 16 16">
              <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
            </svg>
        <% end %>
      <% end %>

    <%= link_to campaign_chapters_path(@campaign), class: "nav-link text-dark w-100", id: "link3-tab" do %>
      Chapters
      <svg width="30" height="30" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-list-ol d-block mx-auto" viewBox="0 0 16 16">
        <path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5"/>
        <path d="M1.713 11.865v-.474H2c.217 0 .363-.137.363-.317 0-.185-.158-.31-.361-.31-.223 0-.367.152-.373.31h-.59c.016-.467.373-.787.986-.787.588-.002.954.291.957.703a.595.595 0 0 1-.492.594v.033a.615.615 0 0 1 .569.631c.003.533-.502.8-1.051.8-.656 0-1-.37-1.008-.794h.582c.008.178.186.306.422.309.254 0 .424-.145.422-.35-.002-.195-.155-.348-.414-.348h-.3zm-.004-4.699h-.604v-.035c0-.408.295-.844.958-.844.583 0 .96.326.96.756 0 .389-.257.617-.476.848l-.537.572v.03h1.054V9H1.143v-.395l.957-.99c.138-.142.293-.304.293-.508 0-.18-.147-.32-.342-.32a.33.33 0 0 0-.342.338zM2.564 5h-.635V2.924h-.031l-.598.42v-.567l.629-.443h.635z"/>
      </svg>
    <% end %>
  </nav>
</div>

  <!-- Content Panes -->
  <div class="tab-content mt-3" id="myTabContent">
    <div class="tab-pane fade show active" id="synopsis-pane" role="tabpanel" aria-labelledby="synopsis-tab">

        <div id="synopsis-edit" style="display: none;" class="x-3 mx-md-5 pb-3 force_input">
          <%= form_with model: @campaign do |form| %>
            <%= form.text_area :synopsis, class: "form-control w-100 mb-2", rows: 8, style: "background-color: #dbd4a0", placeholder: "Tell everyone what this campaign is about!" %>
            <div class="centering align-items-center">
              <%= form.submit "", class: "edit-submit-button" %>
              <button
                type="button"
                class="edit-cancel-button"
                onclick="document.getElementById('synopsis-edit').style.display = 'none'; document.getElementById('synopsis-display').style.display = 'block';">
              </button>
            </div>
          <% end %>
        </div>

      <!--Characters-->
      </div>

    <!--Characters-->
    </div>
    <div class="tab-pane fade" id="characters-pane" role="tabpanel" aria-labelledby="characters-tab">
      <h2 class="text-center" style="font-family: 'Jersey 10'; font-size: 2.1rem;">Master of Ceremonies</h2>
      <div class="text-center">
        <% if @campaign.user.profile_picture&.attached? %>
          <%= image_tag @campaign.user.profile_picture, class: "align-center", style: "max-height: 100px; width: 100px; object-fit: cover; border-radius: 8px;" %>
        <% else %>
          <%= image_tag "default-avatar.png", class: "align-center", style: "max-height: 100px; width: 100px; object-fit: cover; border-radius: 8px;" %>
        <% end %>
        <br>
        <h2 class="text-center border-top pt-2 mx-3" style="font-family: 'Jersey 10'; font-size: 2rem; border-top-color: #c1b77a !important;">Characters</h2>
        <div class="row row-cols-1 row-cols-md-3 flex-wrap gap-3 justify-content-center mx-md-auto" style="max-width: 1000px;">
          <% @campaign.characters.each do |character| %>
            <div class="mx-auto" style="flex: 1 1 280px; max-width: 320px; min-width: 250px;">
              <%= link_to character_path(character), class: "text-decoration-none" do %>
                <div class="card-body">
                  <div class="d-flex align-items-center justify-content-between">
                    <p class="card-title" style="color: rgb(3, 153, 212); text-shadow: 1px 1px 3px rgb(164, 214, 255); font-size: 1.25rem;">
                      <%= character.name %>
                    </p>
                    <% if character.portrait.attached? %>
                      <%= image_tag character.portrait, style: "width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" %>
                    <% else %>
                      <%= image_tag "default-portrait.jpg", style: "max-height: 70px; border-radius: 8px;" %>
                    <% end %>
                  </div>
                  <p class="card-text text-muted">
                    Played by: <%= character.participation.user.username ? character.participation.user.username : character.participation.user.email  %>
                              <% if character.participation.user.profile_picture.attached? %>
                                <%= image_tag character.participation.user.profile_picture, class: "avatar", style: "height: 50px; width: 50px; object-fit: cover" %>
                              <% else %>
                                <%= image_tag "default-avatar.png", class: "avatar", style: "height: 50px; width: 50px; object-fit: cover"%>
                              <% end %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="text-center mt-5 pb-4">
        <%= link_to new_campaign_character_path(@campaign.id), class: "d-inline-flex text-decoration-none align-items-center gap-1" do %>
          <span class="btn btn-dark px-4 py-2">Create New Character</span>
          <%= image_tag "create-character-icon.gif", class: "mb-2", style: "height: 50px; width: 50px; object-fit: cover" %>
        <% end %>
      </div>
    </div>

    <!--Notes-->
    <div class="tab-pane fade" id="notes-pane" role="tabpanel" aria-labelledby="notes-tab">
      <ul style="list-style-type: none; padding-left: 0;">
        <div class="container d-flex flex-column">
          <p class="text-center">Only you can see these notes!</p>
          <% @notes.each do |note| %>
            <div class="container d-flex flex-row gap-4 align-items-center" style="background-color: #dbd4a0; margin: 10px auto; padding: 10px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
              <svg width="48" height="48" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-card-text" style="min-width: 10px; height: auto;" viewBox="0 0 16 16">
                <path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2z"/>
                <path d="M3 5.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5M3 8a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 8m0 2.5a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5"/>
              </svg>
              <!-- Show Notes -->
              <li class="flex-grow-1" style="min-width: 0;">
                <h2 style="word-break: break-word; overflow-wrap: break-word; margin: 0;"><%= note.entry %></h2>
              </li>
                <%= button_to campaign_note_path(@campaign, note),
                    method: :delete,
                    class: "btn ps-0 ms-0",
                    style: "color: red; font-size: 30px;",
                    onclick: "return confirm('Delete this note?');",
                    data: { turbo: false } do %>
                  &#x2715;
                <% end %>
            </div>
          <% end %>
        </div>
        <div class="text-center mt-5 pb-4">
          <%= link_to new_campaign_character_path(@campaign.id), class: "d-inline-flex text-decoration-none align-items-center gap-1" do %>
            <button class="create-character-button"></button>
          <% end %>
        </div>
      </div>

      <!--Notes-->
      <div class="tab-pane fade" id="link2-pane" role="tabpanel" aria-labelledby="link2-tab">
        <ul style="list-style-type: none; padding-left: 0;">
          <div class="container d-flex flex-column">
            <p class="text-center">Only you can see these notes!</p>
            <% @notes.each do |note| %>
              <div class="container d-flex flex-row gap-4 align-items-center" style="background-color: #dbd4a0; margin: 10px auto; padding: 10px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
                <svg width="48" height="48" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-card-text" style="min-width: 10px; height: auto;" viewBox="0 0 16 16">
                  <path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2z"/>
                  <path d="M3 5.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5M3 8a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 8m0 2.5a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5"/>
                </svg>
                <!-- Show Notes -->
                <li class="flex-grow-1" style="min-width: 0;">
                  <h2 style="word-break: break-word; overflow-wrap: break-word; margin: 0;"><%= note.entry %></h2>
                </li>
                  <%= button_to campaign_note_path(@campaign, note),
                      method: :delete,
                      class: "btn ps-0 ms-0",
                      style: "color: red; font-size: 30px;",
                      data: { turbo_confirm: "Delete this note?" } do %>
                    &#x2715;
                  <% end %>
              </div>
            <% end %>
          </div>
        </ul>

      <!-- Add a note -->

      <div id="add-note-form" class="mx-3 mx-md-5 pb-3 force_input" style="display: none;">
        <%=  form_with scope: :note, url: campaign_notes_path(@campaign), data: { turbo: false } do |form| %>
          <%= form.text_area :entry,
              class: "form-control mb-2",
              rows: 4,
              placeholder: "Write a note...",
              style: "background-color: #dbd4a0" %>
          <%= form.submit "Save", class: "btn btn-dark" %>
          <button
            type="button"
            class="btn btn-dark"
            onclick="document.getElementById('add-note-form').style.display = 'block'; document.getElementById('add-note-button').style.display = 'none';">
            + Add note
          </button>
        </div>

        <div id="add-note-form" class="mx-3 mx-md-5 pb-3 force_input" style="display: none;">
          <%=  form_with scope: :note, url: campaign_notes_path(@campaign) do |form| %>
            <%= form.text_area :entry,
                class: "form-control mb-2",
                rows: 4,
                placeholder: "Write a note...",
                style: "background-color: #dbd4a0" %>
            <%= form.submit "Save", class: "btn btn-dark" %>
            <button
              type="button"
              class="btn btn-secondary"
              onclick="document.getElementById('add-note-form').style.display = 'none'; document.getElementById('add-note-button').style.display = 'flex';">
              Cancel
            </button>
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>`
