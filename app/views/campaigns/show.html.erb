<!-- Content Panes -->
<div class="tab-content mt-3" id="myTabContent">
  <div class="tab-pane fade show active" id="active-pane" role="tabpanel" aria-labelledby="active-tab">

  <div id="synopsis-display">
        <p class="mt-auto text-center">
          <%= @campaign.synopsis %>
          <button
            type="button"
            class="btn btn-link text-dark"
            onclick="document.getElementById('synopsis-edit').style.display = 'block'; document.getElementById('synopsis-display').style.display = 'none';">
            Edit
          </button>
        </p>
      </div>

      <div id="synopsis-edit" style="display: none;">
        <%= form_with model: @campaign do |form| %>
          <%= form.text_area :synopsis, class: "form-control w-100", rows: 8 %>
          <%= form.submit "Save", class: "btn btn-secondary btn-sm rounded-3" %>
          <button
            type="button"
            class="btn btn-secondary btn-sm rounded-3"
            onclick="document.getElementById('synopsis-edit').style.display = 'none'; document.getElementById('synopsis-display').style.display = 'block';">
            Cancel
          </button>
        <% end %>
      </div>

    <p></p>
  </div>
  <div class="tab-pane fade" id="link1-pane" role="tabpanel" aria-labelledby="link1-tab">
    <h2 class="text-center" style="font-family: 'Jersey 10'; font-size: 2.1rem;">Master of Ceremonies</h2>
    <div class="text-center">
      <% if @campaign.user.profile_picture&.attached? %>
        <%= image_tag @campaign.user.profile_picture, class: "align-center", style: "max-height: 100px; width: 100px; object-fit: cover; border-radius: 8px;" %>
      <% else %>
        <%= image_tag "default-avatar.png", class: "align-center", style: "max-height: 100px; width: 100px; object-fit: cover; border-radius: 8px;" %>
      <% end %>
      <br>
      <%= @campaign.user.username ? @campaign.user.username : @campaign.user.email  %>
    </div>
    <br>
    <h2 class="text-center border-top pt-2 mx-3" style="font-family: 'Jersey 10'; font-size: 2rem; border-top-color: #c1b77a !important;">Characters</h2>
  <div class="row row-cols-1 row-cols-md-3 flex-wrap gap-3 justify-content-center mx-md-auto" style="max-width: 1000px;">
    <% @campaign.characters.each do |character| %>
  <div class="mx-auto" style="flex: 1 1 280px; max-width: 320px; min-width: 250px;">
    <%= link_to character_path(character), class: "text-decoration-none" do %>
      <div class="card shadow-sm" style="border-radius: 5px; background-color: transparent;">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <h5 class="card-title">
              <%= character.name %>
            </h5>
            <% if character.portrait.attached? %>
              <%= image_tag character.portrait, style: "width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" %>
            <% else %>
              <%= image_tag "default-portrait.jpg", style: "max-height: 70px; border-radius: 8px;" %>
            <% end %>
          </div>
          <p class="card-text text-muted">
            Played by: <%= character.participation.user.username ? character.participation.user.username : character.participation.user.email  %>
                      <% if character.participation.user.profile_picture.attached? %>
                        <%= image_tag character.participation.user.profile_picture, class: "avatar", style: "height: 50px; width: 50px; object-fit: cover" %>
                      <% else %>
                        <%= image_tag "default-avatar.png", class: "avatar", style: "height: 50px; width: 50px; object-fit: cover"%>
                      <% end %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
  </div>
