<div class="container py-3 text-center" data-controller="recording">

  <!-- Character Sheets -->
  <div class="centering mb-4">
    <div class="campaign-book" style="width: 12rem; height: 13rem;">
      <%= image_tag "Quill-logo.gif", style: "width: 10rem; height: 10rem; object-fit: contain;" %>
    </div>
  </div>

  <!-- Audio Recording and Transcription Controls -->
  <div class="centering">
    <div class="book-page-container" data-recording-chapter-id-value="<%= @test_chapter.id %>" data-recording-campaign-id-value="<%= @campaign.id %>">
      <div class="recording-page">
        <p class="mb-4 fs-3" style="color: rgb(3, 153, 212); text-shadow: 1px 1px 3px rgb(164, 214, 255);" data-recording-target="heading">
          Quill at the ready
        </p>
        <div id="record-button" class="mt-auto text-reset clickable-icon" style="cursor: point;">
          <svg data-recording-target="recordIcon" data-action="click->recording#toggle" style="background-image: url(<%= asset_url("recording-paused-icon.gif") %>); background-size: cover;" width="96" height="96" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
            <title>Start recording</title>
          </svg>
          <svg data-recording-target="pauseIcon" data-action="click->recording#pause" class="bi bi-pause-circle icon-pause" width="72" height="72" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" style="display: none; background-image: url(<%= asset_url("recording-icon.gif") %>); background-size: cover;">
            <title>Pause recording</title>
          </svg>
        </div>
        <div class="timer mt-4 mb-4">
          <h2 data-recording-target="timer">00:00:00</h2>
        </div>

        <!-- Generated Transcript -->
        <div id="transcription-output" data-recording-target="output" class="mt-3 p-3 border rounded bg-light d-none position-relative" style="position: absolute; top: 0; right: 0; cursor: pointer;">
          <div class="d-flex justify-content-center mb-2 clickable-icon" style="cursor: pointer;" data-action="click->recording#downloadTranscript" title="Download transcript">
            <svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-download" viewBox="0 0 16 16">
              <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>
              <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"/>
            </svg>
          </div>
          <div data-recording-target="transcript">
            Waiting for speech...
          </div>
        </div>
      </div>

    </div>

  </div>
  <!-- Recording Controls -->
  <div class="centering">
    <div class="text-border mt-5">
      <div class="recording-controls">

        <!-- return to campaign's page -->
        <%= link_to campaign_path(@campaign) do %>
          <button class="back-button" data-direction="back"></button>
        <% end %>

        <!-- upload an audio file -->
        <div class="upload-audio-button">
          <input type="file" id="audio-file" class="d-none" data-action="change->recording#uploadAudioFile">
          <label for="audio-file" title="Upload audio file" style="cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px;">
          </label>
        </div>

        <!-- Generate Transcription -->
        <div data-action="click->recording#generateTranscript">
          <button class="finish-recording-button" ></button>
        </div>

        <!-- finish recording and generate summary -->
        <%= link_to campaign_chapter_path(@campaign, @test_chapter) do %>
          <button class="create-chapter-button"></button>
        <% end %>
      </div>
    </div>
  </div>
</div>
