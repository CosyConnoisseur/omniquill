<div class="container py-5 text-center">
  <h1 class="mb-4">Omniquill</h1>
  <div class="mb-5">
    <%= link_to "Character Sheets", root_path, class: "btn btn-outline-secondary" %>
  </div>
  <div data-controller="recording">
    <div class="recording-page">
      <h1 class="mb-4" data-recording-target="heading">
        Ready when you are!
      </h1>
      <button
        type="button"
        class="btn recording-button"
        data-action="click->recording#toggle"
        >
        <i
          class="fa-solid fa-circle"
          data-recording-target="icon"
        ></i>
      </button>
      <div class="timer mt-4">
        00:00:00
      </div>
      <div class="recording-controls d-flex justify-content-center align-items-center gap-4 mt-4">
        <button type="button" class="btn control-button">
          <i class="fa-solid fa-rotate-left"></i>
        </button>
        <button type="button" class="btn control-button">
          <i class="fa-solid fa-circle-stop"></i>
        </button>
      </div>
    </div>
  </div>
</div>
