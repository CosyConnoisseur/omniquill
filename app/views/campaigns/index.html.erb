<div class="centering">
  <div class="medieval-title">
    <h1>Campaigns</h1>
  </div>
</div>

<div class="centering">
  <div class="bookshelf-container">
    <% @campaigns.each do |campaign| %>

      <div class="campaign-book">
        <nav class="navbar navbar-expand-sm navbar-book">
          <div class="container-fluid">
            <a href="#" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <%= image_tag "dropdown-icon", alt: "dropdown menu", id: "bookmark-dropdown" %>
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <%= link_to invite_campaign_path(campaign), class: "animate-button-dropdown dropdown-item" do %>
                <%= image_tag "invite-player-icon.png", class: "animate-icon-dropdown" %>
                <%= image_tag "invite-player-icon.gif",  class: "animate-move-icon-dropdown" %>
                <p id="invite-text">Invite Players</p>
              <% end %>
              <%= render "form_card_image", campaign:campaign, class: "dropdown-item" %>
            </div>
          </div>
        </nav>
      <%= link_to campaign_path(campaign) do %>
        <% if campaign.card_image.attached? %>
          <div class="campaign-image">
            <%= image_tag campaign.card_image, style: "max-height: 550px;" %>
          </div>
        <% else %>
          <div class="campaign-image">
            <%= image_tag "default-card-image.jpg", style: "max-height: 550px;" %>
          </div>
        <% end %>
        <h5 class="book-title"><%= campaign.title %></h5>
      <% end %>
        <p style="font-size: 0.75rem; margin: 0;" class="text-center">
          Last Played:
          <% if campaign.last_played_at.present? %>
              <%= campaign.last_played_at&.strftime("%B %d, %Y")%> | <%# We can choose one or both of these or maybe add some conditional%>
            <%= time_ago_in_words(campaign.last_played_at) %> ago
          <% else %>
            Never
          <% end %>
        </p>

        <div class="participants-block">
          <% campaign.participations.each do |participation| %>
            <div class="single-participant">
              <% if participation.user.profile_picture.attached? %>
                <%= image_tag participation.user.profile_picture, class: "avatar", style: "height: 50px; width: 50px; object-fit: cover; border-radius: 50%;" %>
              <% else %>
                <%= image_tag "default-avatar.png", class: "avatar", style: "height: 50px; width: 50px; object-fit: cover; border-radius: 50%;" %>
              <% end %>
              <p><%= participation.user.username ? participation.user.username : participation.user.email  %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<div class="centering my-3">
  <%= link_to new_campaign_path, class: "position-fixed", style: "bottom: 20px; right: 20px; z-index: 1050; width: 100px; height: 100px;" do %>
    <%= image_tag "campaign-creation-icon.png", class: "", style: "width: 100%; height: 100%; object-fit: contain;"%>
  <% end %>
</div>
<div class="centering">
  <div class="medieval-title">
    <h2>My characters</h2>
  </div>
</div>

<div class="list-div d-flex flex-column flex-md-row gap-4 justify-content-md-evenly align-items-center align-items-md-start m-3">
  <div class="flex-grow-1" style="max-width: 320px; min-width: 280px;">
    <ul class="list-unstyled d-flex flex-column gap-3">
      <% current_user.characters.each do |character| %>
        <li>
          <div>
            <%= link_to character_path(character), class: "text-decoration-none" do %>
              <div class="card shadow-sm" style="border-radius: 5px; background-color: transparent;">
                <div class="card-body">
                  <div class="d-flex align-items-center justify-content-between">
                    <h5 class="card-title" style="font-family: Luxurious Roman;">
                      <%= character.name %>
                    </h5>
                    <% if character.portrait.attached? %>
                      <%= image_tag character.portrait, class: "character-preview-pic" %>
                    <% else %>
                      <%= image_tag "default-portrait.jpg", class: "character-preview-pic" %>
                    <% end %>
                  </div>
                    <p class="card-text text-muted">
                    Campaign: <%= character.participation.campaign.title %>
                  </p>
                  <p class="card-text text-muted">
                    Played by: <%= current_user.username ? current_user.username : current_user.email  %>
                      <% if character&.participation&.user&.profile_picture&.attached? %>
                        <%= image_tag current_user.profile_picture, class: "avatar", style: "height: 50px; width: 50px; object-fit: cover" %>
                      <% else %>
                        <%= image_tag "default-avatar.png", class: "avatar"%>
                      <% end %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <%# Remove the bottom of this code near the end of this project deadline. %>
  <div class="flex-grow-1" style="max-width: 400px; min-width: 280px;">
    <h2 class="mb-3" style="color: white">Every Character in the DB!</h2>
      <ul class="list-unstyled d-flex flex-column gap-3" style="max-width: 320px;">
        <% @characters.each do |character| %>
          <li>
            <div>
              <%= link_to character_path(character), class: "text-decoration-none" do %>
                <div class="card shadow-sm" style="border-radius: 5px; background-color: transparent;">
                  <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                      <h5 class="card-title">
                        <%= character.name %>
                      </h5>
                      <% if character.portrait.attached? %>
                        <%= image_tag character.portrait, class: "character-preview-pic" %>
                      <% else %>
                        <%= image_tag "default-portrait.jpg", class: "character-preview-pic" %>
                      <% end %>
                    </div>
                    <p class="card-text text-muted">
                      Played by: <%= character.participation.user.username ? character.participation.user.username : character.participation.user.email  %>
                      <% if character&.participation&.user&.profile_picture&.attached? %>
                        <%= image_tag character.participation.user.profile_picture, class: "avatar" , style: "height: 50px; width: 50px; object-fit: cover" %>
                      <% else %>
                        <%= image_tag "default-avatar.png", class: "avatar", style: "height: 50px; width: 50px; object-fit: cover"%>
                      <% end %>
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
  </div>
</div>
