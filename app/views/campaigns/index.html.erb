<div class="centering">
  <div class="medieval-title">
    <h1>Campaigns</h1>
  </div>
</div>

<div class="centering">
  <div class="bookshelf-container">

    <% @campaigns.each do |campaign| %>

        <div class="campaign-book">
          <nav class="navbar navbar-expand-sm navbar-book">
            <div class="container-fluid">
              <a href="#" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <%= image_tag "dropdown-icon", alt: "dropdown menu" %>
              </a>
              <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                <%= link_to "Action", "#", class: "dropdown-item" %>
                <%= link_to "Another action", "#", class: "dropdown-item" %>
                <%= link_to "Log out", destroy_user_session_path, data: {turbo_method: :delete}, class: "dropdown-item" %>
              </div>
            </div>
          </nav>
        <%= link_to campaign_path(campaign) do %>

          <% if campaign.card_image.attached? %>
            <div class="campaign-image">
              <%= image_tag campaign.card_image, style: "max-height: 550px;" %>
            </div>
          <% else %>
          <div class="campaign-image">
            <%= image_tag "default-card-image.jpg", style: "max-height: 550px;" %>
          </div>
          <% end %>

          <h5 class="book-title"><%= campaign.title %></h5>

        <% end %>
          <%= render "form_card_image", campaign:campaign %>

          <div class="d-flex justify-content-center my-2">
            <%= link_to join_campaign_url(campaign), class: "animate-button" do %>
              <%= image_tag "invite-player-icon.png", class: "animate-icon" %>
              <%= image_tag "invite-player-icon.gif",  class: "animate-move-icon" %>
            <% end %>
          </div>

        </div>

    <% end %>

  </div>
</div>
<div class="centering my-3">
  <%= link_to "New Campaign", new_campaign_path, class: "invite-button" %>
</div>


<div class="centering">
  <div class="medieval-title">
    <h2>And characters!</h2>
  </div>
</div>

<div class="centering my-3">
  <% if current_user.participations.exists? %>
    <%= link_to "Create New Character", new_campaign_character_path(current_user.participations.last.campaign), class: "invite-button" %>
  <% end %>
</div>

<div class="list-div d-flex flex-column flex-md-row gap-4 justify-content-md-evenly align-items-center align-items-md-start m-3">

  <div class="flex-grow-1" style="max-width: 320px; min-width: 280px;">
    <h2 class="mb-3 text-center" style="color: white">Only My Characters!</h2>
    <ul class="list-unstyled d-flex flex-column gap-3">
      <% current_user.characters.each do |character| %>
        <li>
          <div>
            <%= link_to character_path(character), class: "text-decoration-none" do %>
              <div class="card shadow-sm" style="border-radius: 5px">
                <div class="card-body">
                  <div class="d-flex align-items-center justify-content-between">
                    <h5 class="card-title">
                      <%= character.name %>
                    </h5>
                    <% if character.portrait.attached? %>
                      <%= image_tag character.portrait, style: "width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" %>
                    <% else %>
                      <%= image_tag "default-portrait.jpg", style: "max-height: 70px; border-radius: 8px;" %>
                    <% end %>
                  </div>
                    <p class="card-text text-muted">
                    Campaign: <%= character.participation.campaign.title %>
                  </p>
                  <p class="card-text text-muted">
                    Played by: <%= character.participation.user.email %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>



  <div class="flex-grow-1" style="max-width: 400px; min-width: 280px;">
    <h2 class="mb-3" style="color: white">Every Character in the DB!</h2>
      <ul class="list-unstyled d-flex flex-column gap-3" style="max-width: 320px;">
        <% @characters.each do |character| %>
          <li>
            <div>
              <%= link_to character_path(character), class: "text-decoration-none" do %>
                <div class="card shadow-sm" style="border-radius: 5px">
                  <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                      <h5 class="card-title">
                        <%= character.name %>
                      </h5>
                      <% if character.portrait.attached? %>
                        <%= image_tag character.portrait, style: "width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" %>
                      <% else %>
                        <%= image_tag "default-portrait.jpg", style: "max-height: 70px; border-radius: 8px;" %>
                      <% end %>
                    </div>
                    <p class="card-text text-muted">
                      Played by: <%= character.participation.user.email %>
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
  </div>
</div>
