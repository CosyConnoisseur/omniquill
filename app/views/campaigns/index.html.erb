<div class="centering">
  <div class="medieval-title">
    <h1>Campaigns</h1>
  </div>
</div>

<div class="centering">
  <div class="bookshelf-container">

    <% @campaigns.each do |campaign| %>

        <div class="campaign-book">
        <%= link_to campaign_path(campaign) do %>

          <% if campaign.card_image.attached? %>
            <%= image_tag campaign.card_image, class: "card-img-top", style: "max-height: 550px;" %>
          <% else %>
            <%= image_tag "default-card-image.jpg", class: "card-img-top",  style: "max-height: 550px;" %>
          <% end %>

          <h5 class="book-title"><%= campaign.title %></h5>

        <% end %>
          <%= render "form_card_image", campaign:campaign %>
          <ul class="list-group list-group-flush my-3">
            <li class="list-group-item">
              <strong>Players:</strong>

              <ul>
                <% campaign.participations.each do |participation| %>
                  <li><%= participation.user.username %></li>
                <% end %>
              </ul>
            </li>
          </ul>

          <div class="text-center my-2">
            <%= link_to "Invite Player", join_campaign_url(campaign), class: "invite-button" %>
          </div>

        </div>

    <% end %>

  </div>
</div>
<div class="centering my-3">
  <%= link_to "New Campaign", new_campaign_path, class: "invite-button" %>
</div>


<div class="centering">
  <div class="medieval-title">
    <h2>And characters!</h2>
  </div>
</div>

<div class="centering my-3">
  <% if current_user.participations.exists? %>
    <%= link_to "Create New Character", new_campaign_character_path(current_user.participations.last.campaign), class: "invite-button" %>
  <% end %>
</div>

<ul class="d-flex flex-column align-items-center">
  <% @characters.each do |character| %>
    <li class="list-unstyled" style="width: 90%;">
      <div class="mb-3">
        <%= link_to character_path(character), class: "text-decoration-none" do %>
          <div class="card shadow-sm">
            <div class="card-body">
              <div class="d-flex align-items-center justify-content-between">
                <h5 class="card-title">
                  <%= character.name %>
                </h5>
                <% if character.portrait.attached? %>
                  <%= image_tag character.portrait, style: "width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" %>
                <% else %>
                  <%= image_tag "default-portrait.jpg", style: "max-height: 70px; border-radius: 8px;" %>
                <% end %>
              </div>
              <p class="card-text text-muted">
                Played by: <%= character.participation.user.username %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
  </li>
<% end %>
</ul>
