<h1>Campaigns</h1>

<div class="container mt-4">
  <div class="row">

    <% @campaigns.each do |campaign| %>
      <div class="col-md-4 mb-4">

        <div class="card" style="width: 18rem;">
        <%= link_to campaign_path(campaign), class: "d-block" do %>

          <% if campaign.card_image.attached? %>
            <%= image_tag campaign.card_image, class: "card-img-top", style: "max-height: 550px;" %>
          <% else %>
            <%= image_tag "default-card-image.jpg", class: "card-img-top",  style: "max-height: 550px;" %>
          <% end %>
          <%# <img src="" class="card-img-top" alt="Campaign image"> %>

          <div class="card-body">
            <h5 class="card-title"><%= campaign.title %></h5>
          </div>
        <% end %>
          <%= render "form_card_image", campaign:campaign %>
          <ul class="list-group list-group-flush">
            <li class="list-group-item">
              <strong>Players:</strong>

              <ul>
                <% campaign.participations.each do |participation| %>
                  <li><%= participation.user.email %></li>
                <% end %>
              </ul>
            </li>
          </ul>

          <div class="card-body">
            <%= link_to "Invite Player", join_campaign_url(campaign), class: "card-link" %>

          </div>

        </div>

      </div>
    <% end %>

  </div>
</div>

<%= link_to "New Campaign", new_campaign_path, class: "btn btn-primary" %>




<h2>And characters!</h2>
<% if current_user.participations.exists? %>
  <%= link_to "Create New Character", new_campaign_character_path(current_user.participations.last.campaign), class: "btn btn-primary ms-3" %>
<% else %>
  <p>Go create a campaign!</p>
<% end %>

<div class="list-div d-flex flex-column flex-md-row gap-4">

  <div>
  <h2>Only My Characters!</h2>
  <ul>
    <% current_user.characters.each do |character| %>
      <li class="list-unstyled">
        <div class="col-md-4 mb-3">
          <%= link_to character_path(character), class: "text-decoration-none" do %>
            <div class="card shadow-sm"  style="min-width: 300px";>
              <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                  <h5 class="card-title">
                    <%= character.name %>
                  </h5>
                  <% if character.portrait.attached? %>
                    <%= image_tag character.portrait, style: "width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" %>
                  <% else %>
                    <%= image_tag "default-portrait.jpg", style: "max-height: 70px; border-radius: 8px;" %>
                  <% end %>
                </div>
                  <p class="card-text text-muted">
                  Campaign: <%= character.participation.campaign.title %>
                </p>
                <p class="card-text text-muted">
                  Played by: <%= character.participation.user.email %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
    </li>
  <% end %>
  </ul>
    </div>



  <div>
  <h2>Characters from my Campaigns!</h2>
  <ul>
    <% @campaign_characters.each do |character| %>
      <li class="list-unstyled">
        <div class="col-md-4 mb-3">
          <%= link_to character_path(character), class: "text-decoration-none" do %>
            <div class="card shadow-sm"  style="min-width: 300px";>
              <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                  <h5 class="card-title">
                    <%= character.name %>
                  </h5>
                  <% if character.portrait.attached? %>
                    <%= image_tag character.portrait, style: "width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" %>
                  <% else %>
                    <%= image_tag "default-portrait.jpg", style: "max-height: 70px; border-radius: 8px;" %>
                  <% end %>
                </div>
                  <p class="card-text text-muted">
                  Campaign: <%= character.participation.campaign.title %>
                </p>
                <p class="card-text text-muted">
                  Played by: <%= character.participation.user.email %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
    </li>
  <% end %>
  </ul>
    </div>


  <div>
  <h2>Every character in the DB!</h2>
  <ul>
    <% @characters.each do |character| %>
      <li class="list-unstyled">
        <div class="col-md-4 mb-3">
          <%= link_to character_path(character), class: "text-decoration-none" do %>
            <div class="card shadow-sm"  style="min-width: 300px";>
              <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                  <h5 class="card-title">
                    <%= character.name %>
                  </h5>
                  <% if character.portrait.attached? %>
                    <%= image_tag character.portrait, style: "width: 70px; height: 70px; object-fit: cover; border-radius: 8px;" %>
                  <% else %>
                    <%= image_tag "default-portrait.jpg", style: "max-height: 70px; border-radius: 8px;" %>
                  <% end %>
                </div>
                <p class="card-text text-muted">
                  Played by: <%= character.participation.user.email %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
    </li>
  <% end %>
  </ul>
</div>
  </div>
