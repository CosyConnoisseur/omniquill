<div class="invite-page">
  <div class="summoning-display">
    <!-- LEFT CANDLE -->
    <%= image_tag "floaty-candle.png", class: "candle candle-left" %>
    <!-- SIGN -->
    <div class="summoning-sign">
      <%= image_tag "rune-of-summoning-floaty-sign.png",
          class: "summoning-sign-image" %>
      <span>Rune of Summoning</span>
    </div>
    <!-- RIGHT CANDLE -->
    <%= image_tag "floaty-candle.png", class: "candle candle-right" %>
  </div>
  <div class="d-flex flex-column align-items-center justify-content-center">
    <div class="qr-code mt-3 mb-4">
      <%= raw @qr_svg %>
    </div>
    <button class="mt-4"
      type="button"
      data-controller="invite-link"
      data-invite-link-url-value="<%= join_campaign_url(@campaign) %>"
      data-action="click->invite-link#copy">
      🔗 Copy Invite Link
    </button>
  </div>
</div>
